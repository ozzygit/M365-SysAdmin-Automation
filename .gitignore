# Ignore everything by default
*

# Keep directories so we can re-include files inside them
!*/

# Keep repository metadata and documentation
!README.md
!LICENSE
!.gitattributes
!.gitignore
!AGENTS.md
!*.md

# Allow PowerShell and Python automation scripts
!*.ps1
!*.psm1
!*.psd1
!*.ps1xml
!*.py

# Allow project folders used for automation work
!/scripts/
!/scripts/**
!/test/
!/test/**
!/modules/
!/modules/**
!/tools/
!/tools/**
!/configs/
!/configs/**

# Keep editor / AI tooling configuration
!/.devin/
!/.devin/**
!/.windsurf/
!/.windsurf/settings.json
